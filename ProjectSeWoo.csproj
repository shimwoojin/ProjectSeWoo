<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>ProjectSeWoo</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Godot.NET.Sdk 는 프로젝트 폴더 아래 모든 .cs 를 자동으로 컴파일한다.
    tools/ 는 개발 도구(VS F5 런처)이고 게임의 일부가 아니므로 제외한다.
    제외하지 않으면 런처 코드가 ProjectSeWoo.dll 안에 같이 들어간다.
    Godot 에디터 쪽은 tools/.gdignore 가 같은 역할을 한다.
  -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <!--
      입력 헬퍼는 별도 exe 다. 여기서 제외하지 않으면 헬퍼 코드가
      ProjectSeWoo.dll 안에도 같이 들어가고, 그러면 "게임 본체에는 키보드
      원본을 만지는 코드가 없다"(§7-2)가 성립하지 않는다.
    -->
    <Compile Remove="platform/InputHelper/**" />
  </ItemGroup>
</Project>
